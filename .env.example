# --- Backend ---
# DATABASE
POSTGRES_USER=shifts
POSTGRES_PASSWORD=shifts_password
POSTGRES_DB=shifts_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://shifts:shifts_password@db:5432/shifts_db

# APP
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth (Google Cloud Console → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# 制限したい Workspace ドメイン（例: example.co.jp）
ALLOWED_GOOGLE_DOMAIN=

# LLM Provider (openai or anthropic)
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
